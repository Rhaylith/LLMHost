<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LLMHostProject</RootNamespace>
    <AssemblyName>llmhost</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <!-- MSB3277: WebView2's WPF assembly references WindowsBase 5.0, which the WinForms-only app never uses -->
    <NoWarn>$(NoWarn);CS1591;CA2252;SKEXP0001;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- the test project lives below this folder: keep its sources out of the application -->
    <Compile Remove="tests\**" />
    <Compile Remove="Updater\**" />
    <EmbeddedResource Remove="Updater\**" />
    <None Remove="Updater\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="LLMHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="Web\app.css" LogicalName="ui/app.css" />
    <EmbeddedResource Include="Web\ui\*.js" LogicalName="ui/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Web\vendor\*.js;Web\vendor\*.css" LogicalName="ui/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Models\catalog.json" LogicalName="catalog.json" />
    <EmbeddedResource Include="Web\locales\*.json" LogicalName="ui/locales/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the updater program travels with the application: built and published into an "updater" folder next to llmhost.exe -->
  <Target Name="BuildUpdater" AfterTargets="Build" Condition="'$(BuildingUpdater)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\Updater\LLMHost.Updater.csproj&quot; -c $(Configuration) -o &quot;$(OutDir)updater&quot; -p:BuildingUpdater=true -v q -nologo" />
  </Target>
  <Target Name="PublishUpdater" AfterTargets="Publish" Condition="'$(BuildingUpdater)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\Updater\LLMHost.Updater.csproj&quot; -c $(Configuration) -o &quot;$(PublishDir)updater&quot; -p:BuildingUpdater=true -v q -nologo" />
  </Target>
</Project>
